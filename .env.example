# 截图中的 APUS X-API 网关，模型经 TokenHub 转发
TOKENHUB_BASE_URL=https://test-stark.apuscn.com/v1
TOKENHUB_MODEL=deepseek-flash
TOKENHUB_API_KEY=
PORT=3210
# 直连腾讯 TokenHub 时改为 https://tokenhub.tencentmaas.com/v1
# 同时使用该平台签发的 Key 和模型 ID deepseek/deepseek-flash

# 可选：额外技能根目录，多个用系统路径分隔符分开；修改后重启服务
# SKILL_DIRS=/absolute/path/to/skills:/another/skills
